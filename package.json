{
  "name": "estud-monorepo",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "web": "bun --cwd apps/web dev",
    "mobile": "bun --cwd apps/mobile expo start",
    "mobile:tunnel": "bun --cwd apps/mobile expo start --tunnel",
    "mobile:apk": "bun --cwd apps/mobile build:apk",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "bun --filter @estud/db db:generate",
    "db:migrate": "bun --filter @estud/db db:migrate",
    "db:push": "bun --filter @estud/db db:push",
    "db:studio": "bun --filter @estud/db db:studio"
  },
  "devDependencies": {
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
